# Salin ke .env.local lalu isi. Jangan pernah commit .env.local.
# Di Vercel, isi nilai yang sama di Project Settings → Environment Variables.

# Aman dikirim ke browser (hanya berguna bila RLS benar).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alamat situs tanpa garis miring di akhir. Dipakai canonical, hreflang, sitemap, dan Open Graph.
NEXT_PUBLIC_SITE_URL=https://domain-anda.com

# Hanya server. Jangan beri awalan NEXT_PUBLIC_.
# Garam untuk hash IP pengunjung (string acak panjang, misalnya: openssl rand -hex 32).
IP_HASH_SALT=

# Opsional
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=
# URL file audio untuk tombol musik latar di navbar (kosong = tombol disembunyikan).
NEXT_PUBLIC_BACKGROUND_MUSIC_URL=
# Cloudflare Turnstile untuk form kontak dan buku tamu. Kosong = tanpa captcha
# (honeypot dan batas kiriman tetap aktif).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
